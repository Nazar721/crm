{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "outDir": ".test-dist",
    "rootDir": ".",
    "baseUrl": ".",
    "types": ["node"],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["tests/**/*.ts", "lib/**/*.ts", "types/**/*.ts"]
}
