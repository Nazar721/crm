# ============================================================
# Секрети для ЕТАПУ 2 (серверна частина AI-помічника).
# НЕ зберігайте ці значення у браузері (localStorage/sessionStorage/URL).
# Файли .env*.local ігноруються git див. .gitignore.
# Етап 1: ці змінні не використовуються — UI лише показує їхні назви.
# ============================================================

# Провайдер: openai | anthropic | google | custom
AI_PROVIDER=

# Модель (наприклад: gpt-4o-mini, claude-3-5-sonnet-latest)
AI_MODEL=

# API-ключ. ЛИШЕ серверне середовище (process.env), ніколи на клієнті.
AI_API_KEY=

# Необов'язковий власний endpoint (для AI_PROVIDER=custom)
AI_BASE_URL=

# Таймаут запиту до провайдера, мілісекунди
AI_TIMEOUT_MS=
